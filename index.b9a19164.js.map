"use strict";
document.addEventListener("click", function(e) {
    // write code here
    var wall = e.target;
    var spider = document.querySelector(".spider");
    if (!wall.classList.contains("wall")) return;
    var wallRect = wall.getBoundingClientRect();
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    var x = e.clientX - wallRect.left - spiderWidth / 2 - wall.clientLeft;
    var y = e.clientY - wallRect.top - spiderHeight / 2 - wall.clientTop;
    var minX = 0;
    var minY = 0;
    var maxX = wall.clientWidth - spiderWidth;
    var maxY = wall.clientHeight - spiderHeight;
    x = Math.max(minX, Math.min(x, maxX));
    y = Math.max(minY, Math.min(y, maxY));
    spider.style.left = "".concat(x, "px");
    spider.style.top = "".concat(y, "px");
});

